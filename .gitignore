*.db
*.sqlite3
*.db-journal

# 环境变量文件（含 LLM Key、教务接口 Token、JWT Secret）
.env
.env.local
.env.*.local

# ---------- IDE ----------
.idea/
.vscode/
*.iml

# ---------- Agent 本地工作数据 ----------
# WorkBuddy 工作区记忆与本地状态，不属于项目源码
.workbuddy/

# 本地产物：简历（docx/pdf/html）与 html-to-docx 转换 venv
output/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# 黄金集运行产物（17）：fake 产物只做门禁比对不入库；live 结果留档提交
backend/eval/results/*
!backend/eval/results/live-*.json

# FAQ 候选导出（11 §4.1 回流线 K6）：含学生原话，属内部人工审核材料不入库
backend/faq_candidates/

# KB ingest / MCP 测试 subprocess 工作目录（18 AC-18e 幂等验证等的临时产物）
.pytest_tmp/

# 企微机器人 webhook URL（20 O2 告警通道）：含 key 敏感信息不入库，
# 按 ops/alertmanager/wecom_url.txt 模板本地创建
ops/alertmanager/wecom_url.txt

# 项目文档：仅本地保留，不上传仓库
docs/
